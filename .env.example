# RPC
NEXT_PUBLIC_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_CLUSTER=mainnet-beta

# Quote mint (HYPE on Solana, Wormhole NTT). On devnet, create your own 8-decimal test mint and put it here.
NEXT_PUBLIC_QUOTE_MINT=98sMhvDwXj1RQi5c5Mndm3vPe9cBqPrbLaufMXFNMh5g

# The DBC partner config key created by scripts/create-config.ts
NEXT_PUBLIC_DBC_CONFIG=

# Platform wallet: claims partner fees and receives leftovers. Public key only.
NEXT_PUBLIC_FEE_CLAIMER=

# Server-side only — the keypair that pays for config creation (scripts). Path to a JSON keypair file.
PAYER_KEYPAIR=./keys/payer.json
